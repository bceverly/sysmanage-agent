# SysManage Agent Sudoers Configuration for FreeBSD
# This file grants the sysmanage-agent user necessary privileges for system management
# File location: /usr/local/etc/sudoers.d/sysmanage-agent
# Permissions: 0440 (enforced by package installer)
#
# The agent runs as the ``sysmanage-agent`` user when ``sysmanage_agent_user``
# is set in /etc/rc.conf -- see installer/freebsd/sysmanage-agent.rc.
# When the operator runs the agent as root no sudo is needed; this
# file is only consulted under the non-root deployment.

# Package Management (pkg).
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/pkg update
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/pkg install *
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/pkg delete *
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/pkg upgrade *
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/pkg autoremove

# Repository mirroring tools (Pro+ repository_mirroring_engine).
# rsync is the snapshot + restore workhorse -- without it, ``snapshot``
# plans fail at the live-tree -> .snapshots/<id>/ copy with the
# "user not allowed to run" error.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/bin/rsync

# Air-gap collector ISO build (Pro+ airgap_collector_engine): build_iso_plan
# bundles the staging tree with ``sudo xorriso`` and checksums it with
# ``sudo sha256sum``.  Bare-binary grants; without them the run dies at
# BUILDING_ISO with a sudo password prompt.  NOTE: FreeBSD base has no
# ``sha256sum`` (it ships ``sha256``); a FreeBSD collector needs the
# ``coreutils`` pkg, which installs /usr/local/bin/sha256sum.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/bin/xorriso
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/bin/sha256sum
# Optical-disc burn (build_iso_plan with a burn_device): ``sudo
# growisofs`` (dvd+rw-tools pkg) writes the ISO, ``sudo eject``
# (sysutils/eject pkg) ejects it.  CVE/compliance snapshot fetch uses
# ``sudo curl``.  Repository ingestion loop-mounts media read-only.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/bin/growisofs
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/bin/eject
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/bin/curl
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/mount
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/umount
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/bin/createrepo_c
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/bin/trickle

# Helper utilities the mirroring/snapshot/import plans run via sudo.
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/mkdir
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/bin/find
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/chmod
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/chown
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/bin/sed
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/rm

# Generic file deployment via ``sudo install``.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/bin/install

# Service Management (rc.d / service).
# Bare-binary grant: ``service <name> start`` places a wildcard in the MIDDLE
# of the arguments, which sudo 1.9.x rejects -- and a single rejected line
# invalidates the WHOLE sudoers file (agent then loses every grant).  Grant
# the bare binary; the agent's own code constrains service + action.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/service
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/sysrc *

# Firewall Management (pf / ipfw).
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/pfctl *
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/ipfw *

# System Power Management.
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/shutdown -r *
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/shutdown -h *
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/shutdown -p *
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/reboot
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/poweroff

# Certificate Management.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/certctl rehash

# Content Lifecycle Management (Phase 16/19) -- content-view publish, promote
# and serving.  These three were MISSING, and their absence made the whole
# feature non-functional on a real agent: every publish/promote/materialize
# plan opens with ``sudo test -d`` and died on it, so content-view publish had
# never once succeeded outside a harness that strips sudo.  Found by running
# the flow end-to-end against a live agent on 2026-08-25.
#
#   test  -- existence guard at the head of every plan.  A pure predicate: it
#            cannot write, execute or modify anything.  ``find`` is already
#            granted and discloses strictly more.
#   ln    -- the environment promotion ITSELF (``ln -sfn v<N> <env>``), the
#            atomic flip that repoints an environment at a version.
#   nginx -- validating the generated serving config before reload.
#
# NOTE there is deliberately NO ``sh`` here.  ``sudo sh -c`` is arbitrary root
# execution and would defeat the bare-binary policy this file exists to
# enforce; the apt index generation was rewritten to run unprivileged and be
# placed with ``install`` instead.

sysmanage-agent ALL=(ALL) NOPASSWD: /bin/test
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/ln
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/sbin/nginx, /usr/sbin/nginx

# Antivirus deploy plan (server av_plan_builder): refresh the ClamAV signature
# database once, before clamd first starts -- on these platforms installing
# the package does not start the updater, and clamd will not run without a
# database.  Exactly "freshclam" with NO arguments ("" = none allowed): an
# argument such as --config-file could point it at an attacker's config.
# (2026-10-17: the step was refused, "sudo: I'm sorry sysmanage-agent".)
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/bin/freshclam ""
# Stop a clamd started before its configuration was deployed (the plan
# then waits, unprivileged, for it to exit).  Exactly these arguments.
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/pkill -x clamd

# Backups with restate (server ROADMAP Phase 24): the seal step lets a NAS's
# agent snapshot its backup dataset, so a host can never delete history.
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/zfs snapshot *
# A FreeBSD storage host has no systemd, so the agent starts restate itself,
# under daemon(8) (daemon runs as the agent; only restate is elevated):
# exactly ``restate run /etc/restate/jobs.d/<policy uuid>.<prune|check|copy|du|repack|protect>.conf``.
# A regular expression, not a wildcard: ``*`` would also match extra options
# such as ``--result PATH`` -- a root-owned write anywhere.  restate itself
# refuses a job file that is not root's and in a directory only root can
# change.  Needs sudo 1.9.10 or later (FreeBSD 14 ships 1.9.17).
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/sbin/restate ^run /etc/restate/jobs\.d/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.(prune|check|copy|du|repack|protect)\.conf$
# "Prepare storage for this host" (Phase 24, started by an administrator from
# the Backups page): the repository becomes its own ZFS dataset, exported to
# that one host's address only with every client mapped to the backup service
# account; run again it re-exports (the host's address changed).  Regular
# expressions, so only a sharenfs of exactly that shape can be set -- never
# another property.  (Ownership uses the chown/chmod grants above.)
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/zfs ^create -o sharenfs=-mapall=[a-z_][a-z0-9_-]*:[a-z_][a-z0-9_-]* [0-9a-fA-F.:]+ [A-Za-z0-9_.:/-]+$
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/zfs ^set sharenfs=-mapall=[a-z_][a-z0-9_-]*:[a-z_][a-z0-9_-]* [0-9a-fA-F.:]+ [A-Za-z0-9_.:/-]+$

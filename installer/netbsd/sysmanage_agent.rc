#!/bin/sh

# PROVIDE: sysmanage_agent
# REQUIRE: NETWORKING SERVERS
# BEFORE: DAEMON
# KEYWORD: shutdown

# Add the following lines to /etc/rc.conf to enable sysmanage-agent:
# sysmanage_agent=YES
# sysmanage_agent_config="/usr/pkg/etc/sysmanage-agent/config.yaml"
# sysmanage_agent_user="sysmanage-agent"
# sysmanage_agent_group="sysmanage-agent"

. /etc/rc.subr

name="sysmanage_agent"
rcvar=$name
desc="SysManage Agent - System management agent"

load_rc_config $name

: ${sysmanage_agent:="NO"}
: ${sysmanage_agent_config:="/usr/pkg/etc/sysmanage-agent/config.yaml"}
: ${sysmanage_agent_user:="sysmanage-agent"}
: ${sysmanage_agent_group:="sysmanage-agent"}
: ${sysmanage_agent_pidfile:="/var/run/sysmanage/agent.pid"}
: ${sysmanage_agent_logfile:="/var/log/sysmanage-agent/agent.log"}
: ${sysmanage_agent_dbpath:="/var/db/sysmanage-agent/agent.db"}
: ${sysmanage_agent_logdir:="/var/log/sysmanage-agent"}

# The agent parses NO command-line arguments.  ``--config`` was passed here and
# silently discarded (the wrapper execs main.py with "$@", and main.py never
# reads argv), so the agent fell back to its built-in search order --
# SYSMANAGE_CONFIG, then /etc/sysmanage-agent.yaml, then ./sysmanage-agent.yaml
# -- and never looked at the path this script had just verified exists.
# SYSMANAGE_CONFIG / _DB_PATH / _LOG_DIR are the overrides main.py and
# src/database/init.py actually honor.  Without _DB_PATH the SQLite database
# resolves to the process working directory.
export SYSMANAGE_CONFIG="${sysmanage_agent_config}"
export SYSMANAGE_DB_PATH="${sysmanage_agent_dbpath}"
export SYSMANAGE_LOG_DIR="${sysmanage_agent_logdir}"

# Command to execute
command="/usr/pkg/lib/sysmanage-agent/sysmanage-agent-wrapper.sh"
command_args=""
# The wrapper execs Python, so the running agent is the interpreter, not
# /bin/sh: rc.subr finds it by this name (status / stop).
procname="/usr/pkg/bin/python3.12"
start_cmd="sysmanage_agent_start"
# NetBSD's rc.subr runs ``command`` in the FOREGROUND and expects it to
# daemonize itself; the agent does not, so ``service sysmanage_agent start`` never
# returned and no pidfile was written (status and stop could not find the
# process).  Same class of defect as FreeBSD's ``daemon`` without ``-f``
# (2026-10-03).  Start it in the background here, stdin from /dev/null and
# output to the log, and record its pid: ``exec`` keeps that pid the
# agent's Python process's own.  Validated on NetBSD 10.1: the old
# script hung ``service start``; this one returns, and status / restart /
# stop work.
sysmanage_agent_start()
{
	echo "Starting ${name}."
	su -m ${sysmanage_agent_user} -c "exec ${command} \
	    </dev/null >>${sysmanage_agent_logfile} 2>&1 & echo \$! > ${pidfile}"
}

pidfile="${sysmanage_agent_pidfile}"
required_files="${sysmanage_agent_config}"

start_precmd="${name}_prestart"
stop_postcmd="${name}_poststop"

sysmanage_agent_prestart()
{
	# Create directories if they don't exist
	install -d -o ${sysmanage_agent_user} -g ${sysmanage_agent_group} \
		/var/run/sysmanage /var/log/sysmanage-agent /var/db/sysmanage-agent

	# Check config file exists
	if [ ! -f "${sysmanage_agent_config}" ]; then
		echo "Configuration file not found: ${sysmanage_agent_config}"
		echo "Copy the example: cp /usr/pkg/etc/sysmanage-agent/config.yaml.example ${sysmanage_agent_config}"
		return 1
	fi
}

sysmanage_agent_poststop()
{
	rm -f ${pidfile}
}

run_rc_command "$1"

# SysManage Agent Sudoers Configuration for NetBSD
# This file grants the sysmanage-agent user necessary privileges for system management
# File location: /usr/pkg/etc/sudoers.d/sysmanage-agent
# Permissions: 0440 (enforced by package installer)
#
# The agent runs as the ``sysmanage-agent`` user when ``sysmanage_agent_user``
# is set in /etc/rc.conf -- see installer/netbsd/sysmanage_agent.rc.
#
# That account is deliberately NOT the bare "sysmanage" account: these grants
# are root-equivalent in practice (install(1), chmod(1), chown(8), sed(1) with
# unrestricted arguments), and "sysmanage" is what a SysManage SERVER install
# uses for its network-facing web application.  Sharing one account would let a
# web compromise inherit every grant below.
# When the operator runs the agent as root no sudo is needed.

# Package Management (pkgin / pkg_add).
#
# pkgin is granted as a bare binary, as apt-get is on Ubuntu: sudo matches
# arguments POSITIONALLY, and the agent runs ``pkgin -y install ...`` and
# ``pkgin -n upgrade`` -- an option before the command -- which the old
# per-command rules (``pkgin install *``) never matched, so a packaged
# (non-root) agent could neither detect nor install pkgin updates
# (2026-11-23; the lab's agent ran as root and never showed it).  The agent's
# own code decides the arguments; "install *" was already root-equivalent.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/pkgin *
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/pkg_add *
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/pkg_delete *

# Repository mirroring tools (Pro+ repository_mirroring_engine).
# rsync is the snapshot + restore workhorse -- without it, ``snapshot``
# plans fail at the live-tree -> .snapshots/<id>/ copy with the
# "user not allowed to run" error.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/rsync

# Air-gap collector ISO build (Pro+ airgap_collector_engine): build_iso_plan
# bundles the staging tree with ``sudo xorriso`` and checksums it with
# ``sudo sha256sum``.  Bare-binary grants; without them the run dies at
# BUILDING_ISO with a sudo password prompt.  NOTE: NetBSD base has no
# ``sha256sum``; a NetBSD collector needs the pkgsrc ``coreutils`` pkg,
# which installs /usr/pkg/bin/sha256sum (and xorriso via the xorriso pkg).
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/xorriso
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/sha256sum
# Optical-disc burn (build_iso_plan with a burn_device): ``sudo
# growisofs`` writes the ISO, ``sudo eject`` (pkgsrc sysutils/eject)
# ejects it.  CVE/compliance snapshot fetch uses ``sudo curl``.
# Repository ingestion loop-mounts media read-only.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/growisofs
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/eject
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/curl
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/mount
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/umount
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/createrepo_c
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/trickle

# Helper utilities the mirroring/snapshot/import plans run via sudo.
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/mkdir
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/bin/find
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/chmod
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/chown
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/bin/sed
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/rm

# Generic file deployment via ``sudo install``.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/bin/install

# Service Management (rc.d).
sysmanage-agent ALL=(ALL) NOPASSWD: /etc/rc.d/* start
sysmanage-agent ALL=(ALL) NOPASSWD: /etc/rc.d/* stop
sysmanage-agent ALL=(ALL) NOPASSWD: /etc/rc.d/* restart
sysmanage-agent ALL=(ALL) NOPASSWD: /etc/rc.d/* status

# Firewall Management (npf / pf).
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/npfctl *
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/pfctl *

# System Power Management.
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/shutdown -r *
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/shutdown -h *
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/shutdown -p *
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/reboot
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/poweroff

# Content Lifecycle Management (Phase 16/19) -- content-view publish, promote
# and serving.  These three were MISSING, and their absence made the whole
# feature non-functional on a real agent: every publish/promote/materialize
# plan opens with ``sudo test -d`` and died on it, so content-view publish had
# never once succeeded outside a harness that strips sudo.  Found by running
# the flow end-to-end against a live agent on 2026-08-25.
#
#   test  -- existence guard at the head of every plan.  A pure predicate: it
#            cannot write, execute or modify anything.  ``find`` is already
#            granted and discloses strictly more.
#   ln    -- the environment promotion ITSELF (``ln -sfn v<N> <env>``), the
#            atomic flip that repoints an environment at a version.
#   nginx -- validating the generated serving config before reload.
#
# NOTE there is deliberately NO ``sh`` here.  ``sudo sh -c`` is arbitrary root
# execution and would defeat the bare-binary policy this file exists to
# enforce; the apt index generation was rewritten to run unprivileged and be
# placed with ``install`` instead.

sysmanage-agent ALL=(ALL) NOPASSWD: /bin/test
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/ln
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/local/sbin/nginx, /usr/sbin/nginx

# Antivirus deploy plan (server av_plan_builder): refresh the ClamAV signature
# database once, before clamd first starts -- on these platforms installing
# the package does not start the updater, and clamd will not run without a
# database.  Exactly "freshclam" with NO arguments ("" = none allowed): an
# argument such as --config-file could point it at an attacker's config.
# (2026-10-17: the step was refused, "sudo: I'm sorry sysmanage-agent".)
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/bin/freshclam ""

# The antivirus memory floor (ClamAV): SysManage's own swap file, 1 to 8 GB,
# at one of four exact paths, every allowed dd spelled out in full.
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/dd bs=1048576 count=1024 if=/dev/zero of=/sysmanage.swap, /bin/dd bs=1048576 count=2048 if=/dev/zero of=/sysmanage.swap, /bin/dd bs=1048576 count=3072 if=/dev/zero of=/sysmanage.swap, /bin/dd bs=1048576 count=4096 if=/dev/zero of=/sysmanage.swap, /bin/dd bs=1048576 count=5120 if=/dev/zero of=/sysmanage.swap, /bin/dd bs=1048576 count=6144 if=/dev/zero of=/sysmanage.swap, /bin/dd bs=1048576 count=7168 if=/dev/zero of=/sysmanage.swap, /bin/dd bs=1048576 count=8192 if=/dev/zero of=/sysmanage.swap
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/dd bs=1048576 count=1024 if=/dev/zero of=/var/sysmanage.swap, /bin/dd bs=1048576 count=2048 if=/dev/zero of=/var/sysmanage.swap, /bin/dd bs=1048576 count=3072 if=/dev/zero of=/var/sysmanage.swap, /bin/dd bs=1048576 count=4096 if=/dev/zero of=/var/sysmanage.swap, /bin/dd bs=1048576 count=5120 if=/dev/zero of=/var/sysmanage.swap, /bin/dd bs=1048576 count=6144 if=/dev/zero of=/var/sysmanage.swap, /bin/dd bs=1048576 count=7168 if=/dev/zero of=/var/sysmanage.swap, /bin/dd bs=1048576 count=8192 if=/dev/zero of=/var/sysmanage.swap
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/dd bs=1048576 count=1024 if=/dev/zero of=/home/sysmanage.swap, /bin/dd bs=1048576 count=2048 if=/dev/zero of=/home/sysmanage.swap, /bin/dd bs=1048576 count=3072 if=/dev/zero of=/home/sysmanage.swap, /bin/dd bs=1048576 count=4096 if=/dev/zero of=/home/sysmanage.swap, /bin/dd bs=1048576 count=5120 if=/dev/zero of=/home/sysmanage.swap, /bin/dd bs=1048576 count=6144 if=/dev/zero of=/home/sysmanage.swap, /bin/dd bs=1048576 count=7168 if=/dev/zero of=/home/sysmanage.swap, /bin/dd bs=1048576 count=8192 if=/dev/zero of=/home/sysmanage.swap
sysmanage-agent ALL=(ALL) NOPASSWD: /bin/dd bs=1048576 count=1024 if=/dev/zero of=/usr/sysmanage.swap, /bin/dd bs=1048576 count=2048 if=/dev/zero of=/usr/sysmanage.swap, /bin/dd bs=1048576 count=3072 if=/dev/zero of=/usr/sysmanage.swap, /bin/dd bs=1048576 count=4096 if=/dev/zero of=/usr/sysmanage.swap, /bin/dd bs=1048576 count=5120 if=/dev/zero of=/usr/sysmanage.swap, /bin/dd bs=1048576 count=6144 if=/dev/zero of=/usr/sysmanage.swap, /bin/dd bs=1048576 count=7168 if=/dev/zero of=/usr/sysmanage.swap, /bin/dd bs=1048576 count=8192 if=/dev/zero of=/usr/sysmanage.swap
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/swapctl -a /sysmanage.swap, /sbin/swapctl -a /var/sysmanage.swap, /sbin/swapctl -a /home/sysmanage.swap, /sbin/swapctl -a /usr/sysmanage.swap
sysmanage-agent ALL=(ALL) NOPASSWD: /sbin/swapctl -d /sysmanage.swap, /sbin/swapctl -d /var/sysmanage.swap, /sbin/swapctl -d /home/sysmanage.swap, /sbin/swapctl -d /usr/sysmanage.swap

# Compliance evidence (2026-11-23): the SysManage BSD baseline reads the
# EFFECTIVE sshd settings, and sshd -T needs root (it loads the host keys).
# Exactly this argv; nothing else of sshd.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/sbin/sshd -T

# Malware scans' rootkit leg (2026-11-25): chkrootkit and rkhunter read what
# only root can.  These exact arguments only -- nothing that updates their
# databases or changes the host.
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/sbin/chkrootkit -q, /usr/pkg/bin/chkrootkit -q
sysmanage-agent ALL=(ALL) NOPASSWD: /usr/pkg/sbin/rkhunter --check --sk --rwo --nocolors, /usr/pkg/bin/rkhunter --check --sk --rwo --nocolors

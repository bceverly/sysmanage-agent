#!/bin/bash
set -e

# Automatically added by dh_installinit/13.11.4
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	# Create sysmanage-agent user if it doesn't exist
	if ! getent passwd sysmanage-agent >/dev/null; then
		echo "Creating sysmanage-agent system user..."
		adduser --system --group --home /nonexistent --no-create-home \
			--disabled-password --disabled-login \
			--gecos "SysManage Agent" sysmanage-agent
	fi

	# Set ownership of application directories
	chown -R sysmanage-agent:sysmanage-agent /opt/sysmanage-agent
	chown -R sysmanage-agent:sysmanage-agent /var/lib/sysmanage-agent
	chown -R sysmanage-agent:sysmanage-agent /var/log/sysmanage-agent
	chown -R sysmanage-agent:sysmanage-agent /etc/sysmanage-agent

	# Set proper permissions
	chmod 755 /opt/sysmanage-agent
	chmod 755 /var/lib/sysmanage-agent
	chmod 755 /var/log/sysmanage-agent
	chmod 750 /etc/sysmanage-agent

	# Fix virtualenv to work with system Python
	echo "Configuring virtualenv for system Python..."
	# Recreate the venv using the system's Python to fix all symlinks and paths
	cd /opt/sysmanage-agent
	rm -rf .venv
	python3 -m venv .venv
	.venv/bin/pip install --quiet --upgrade pip
	.venv/bin/pip install --quiet -r requirements-prod.txt
	cd -

	# Create config file if it doesn't exist
	if [ ! -f /etc/sysmanage-agent.yaml ]; then
		echo "Creating default configuration file..."
		cp /etc/sysmanage-agent/sysmanage-agent.yaml.example /etc/sysmanage-agent.yaml
		chown sysmanage-agent:sysmanage-agent /etc/sysmanage-agent.yaml
		chmod 640 /etc/sysmanage-agent.yaml
		echo "Please edit /etc/sysmanage-agent.yaml to configure the agent"
	fi

	# Reload systemd daemon
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null 2>&1 || true
	fi

	# Enable and start the service; an upgrade ($2 is the old version)
	# RESTARTS it, or the old code keeps running.  This script owns that on
	# every series (dh_installsystemd --no-start in rules): jammy's debhelper
	# looks for units only under /lib/systemd/system, missed ours under
	# /usr/lib, and added no restart at all -- ubiquiti ran 3.12.0.25 for
	# 20 minutes after upgrading to 3.12.0.27 (production, 2026-11-02).
	action=start
	if [ -n "$2" ]; then
		action=restart
	fi
	if [ -x "/usr/bin/deb-systemd-invoke" ]; then
		deb-systemd-invoke enable sysmanage-agent.service >/dev/null 2>&1 || true
		deb-systemd-invoke "$action" sysmanage-agent.service >/dev/null 2>&1 || true
	elif [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper enable sysmanage-agent.service >/dev/null 2>&1 || true
		deb-systemd-invoke "$action" sysmanage-agent.service >/dev/null 2>&1 || true
	else
		systemctl enable sysmanage-agent.service >/dev/null 2>&1 || true
		systemctl "$action" sysmanage-agent.service >/dev/null 2>&1 || true
	fi

	# The setup steps are for a fresh install only: an upgrade ($2 is the
	# old version) keeps its /etc/sysmanage-agent.yaml, and telling the
	# operator to set server.url again only alarms them.
	if [ -n "$2" ]; then
		echo "SysManage Agent upgraded from $2; its configuration is unchanged."
	else
		echo ""
		echo "=========================================="
		echo "SysManage Agent installation complete!"
		echo "=========================================="
		echo ""
		echo "Next steps:"
		echo "  1. sudo vim /etc/sysmanage-agent.yaml and set:"
		echo "       server.url                 your SysManage server, e.g. https://sysmanage.yourcompany.com"
		echo "       security.enrollment_token  (multi-tenant servers; TOP-LEVEL security section)"
		echo "  2. sudo systemctl restart sysmanage-agent"
		echo "  3. sudo systemctl status sysmanage-agent"
		echo "     Until server.url is set the agent does not start: status shows"
		echo "     'status=78/CONFIG' and the log says what to edit."
		echo "  4. Approve the host on the server's Hosts page."
		echo ""
		echo "Log files are located in: /var/log/sysmanage-agent/"
		echo ""
	fi
fi

#DEBHELPER#

exit 0

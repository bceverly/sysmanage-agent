#!/bin/sh
#
#
# PROVIDE: sysmanage_agent
# REQUIRE: NETWORKING SERVERS DAEMON
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf.local or /etc/rc.conf
# to enable this service:
#
# sysmanage_agent_enable (bool):       Set to NO by default.
#               Set it to YES to enable sysmanage-agent.
# sysmanage_agent_user (str):          Set to "sysmanage-agent" by default.
#               The agent manages the SYSTEM — installs packages, controls
#               services, reboots — so it escalates through the sudoers policy
#               this port installs at %%PREFIX%%/etc/sudoers.d/sysmanage-agent.
#               That policy is NOT a security boundary: it grants install(1),
#               chmod(1), chown(8), sed(1) and sysrc(8) with unrestricted
#               arguments, each of which is by itself equivalent to root.  What
#               the unprivileged deployment buys is an audit trail — sudo logs
#               every privileged action, a root agent logs nothing.  Set this
#               to "root" to run privileged directly, in which case the policy
#               is never consulted.
# sysmanage_agent_dbpath (str):        Set to "/var/db/sysmanage-agent/agent.db".
# sysmanage_agent_logdir (str):        Set to "/var/log/sysmanage-agent".
# sysmanage_agent_config (str):        Set to "%%PREFIX%%/etc/sysmanage-agent.yaml" by default.

. /etc/rc.subr

name=sysmanage_agent
rcvar=sysmanage_agent_enable

load_rc_config $name

: ${sysmanage_agent_enable:="NO"}
: ${sysmanage_agent_user:="sysmanage-agent"}
: ${sysmanage_agent_config:="%%PREFIX%%/etc/sysmanage-agent.yaml"}
: ${sysmanage_agent_dbpath:="/var/db/sysmanage-agent/agent.db"}
: ${sysmanage_agent_logdir:="/var/log/sysmanage-agent"}

# Pidfile in a per-service DIRECTORY, not directly in /var/run.  rc.subr runs
# the command as ${sysmanage_agent_user}, and /var/run is root-owned 0755, so
# an unprivileged daemon(8) cannot create a pidfile there:
#     daemon: pidfile '/var/run/sysmanage_agent.pid': Permission denied
# This did not arise while the agent ran as root.  /var/run is volatile, so the
# directory cannot ship in the package and is created at start time below.
pidfile="/var/run/${name}/${name}.pid"
start_precmd="sysmanage_agent_precmd"

sysmanage_agent_precmd()
{
	/usr/bin/install -d -o "${sysmanage_agent_user}" \
	    -g "${sysmanage_agent_user}" -m 0755 "/var/run/${name}"
}
command="/usr/sbin/daemon"
# procname MUST be the interpreter, not $command.  rc.subr's check_process
# matches the pid in $pidfile against a process named $procname, which
# defaults to $command — here /usr/sbin/daemon.  But ``daemon -p`` writes
# the pid of the CHILD it supervises (python), so the name never matches
# and both onestatus and onestop report "not running" while the service is
# very much running.  Confirmed 2026-08-10: a second onestart answered
# "daemon: process already running, pid: 75353".
procname="%%PYTHON_CMD%%"
# The agent takes NO command-line arguments — ``--config`` was silently
# ignored, so the daemon fell back to its built-in search order
# (/etc/sysmanage-agent.yaml, then ./sysmanage-agent.yaml) and never looked at
# %%PREFIX%%/etc, which is where THIS PORT installs the sample.  The package
# therefore installed cleanly and died on start with "Configuration file not
# found".  poudriere cannot catch that: it builds and packages, it never runs
# the service.  ``SYSMANAGE_CONFIG`` is the documented override the agent does
# honour (main.py), and an absolute path is used verbatim.
export SYSMANAGE_CONFIG="${sysmanage_agent_config}"
# get_database_path_from_config() ends at ``os.getcwd()/agent.db`` when nothing
# else resolves, and daemon(8) -c sets the cwd to / — so as root the agent
# silently created /agent.db, and unprivileged it cannot create the database at
# all.  Both variables are overrides the agent already honours.
export SYSMANAGE_DB_PATH="${sysmanage_agent_dbpath}"
export SYSMANAGE_LOG_DIR="${sysmanage_agent_logdir}"

# NO ``-u ${sysmanage_agent_user}`` here.  ``sysmanage_agent_user`` is
# ${name}_user, an rc.subr knob: when set, run_rc_command wraps the command in
# ``su -m <user> -c ...``, so /usr/sbin/daemon already runs as that user and
# ``daemon -u`` then fails in initgroups(), which requires root.  At the default
# of root both drops are no-ops, which is why this never fired here — but an
# admin who lowered sysmanage_agent_user in rc.conf, exactly as the comment
# above invites, would have got a service that silently refused to start.  The
# SERVER port hit this for real on 2026-08-10; fixed in both for the same
# reason.
command_args="-c -p ${pidfile} \
    %%PYTHON_CMD%% %%PREFIX%%/libexec/sysmanage-agent/main.py"

run_rc_command "$1"
